# Copy to backend/.env for local development. Never commit the real file.
APP_ENV=development
LOG_FORMAT=console

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-in-any-shared-environment-0123456789abcdef
JWT_SECRET_KEY=change-me-in-any-shared-environment-0123456789abcdef

# YugabyteDB YSQL on 5433 (docker compose maps it). `python scripts/yb_bootstrap.py` creates the role and databases.
DATABASE_URL=postgresql+asyncpg://crimeai:crimeai_dev_password@localhost:5433/crimeai
DATABASE_URL_SYNC=postgresql://crimeai:crimeai_dev_password@localhost:5433/crimeai
# Set to 0 when connecting through PgBouncer/Supabase pooler in transaction mode.
DB_STATEMENT_CACHE_SIZE=100

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=*
# Local HTTP dev cannot set Secure cookies.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=var/uploads
# Object storage on DigitalOcean Spaces or Vultr Object Storage: STORAGE_BACKEND=s3 and
# S3_ENDPOINT=https://blr1.digitaloceanspaces.com (or https://blr1.vultrobjects.com), S3_REGION=blr1,
# S3_BUCKET=..., S3_ACCESS_KEY=..., S3_SECRET_KEY=...

ENABLE_ZERO_SHOT=false
# Access requests stay pending until an administrator approves them.
ALLOW_SELF_REGISTRATION=true

# Patrol routes are drawn on the road network via OSRM. The public server receives
# checkpoint coordinates; point this at a self-hosted OSRM for operational use.
ROUTING_ENABLED=true
ROUTING_URL=https://routing.openstreetmap.de


# Meko shared memory between agencies. Get a key at https://cloud.mekodata.ai (Settings -> API Keys).
# With a key set, start.cmd / start.sh run scripts/meko_setup.py (datapacks, SOPs, partner agencies).
MEKO_API_KEY=
MEKO_AGENCY_CODE=DLP
# Every agency on the grid uses the same grid key, so one phone or UPI ID fingerprints identically everywhere.
# MEKO_GRID_KEY=

# Gemini case briefs (English translation and summary of any FIR) and the investigation review (an explanation
# of each contradiction or gap and a draft plan). Leave empty to keep both off.
# Only PII-redacted text is sent. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Tiger Cloud (TimescaleDB) mirror of the crime time series. Create a service at https://console.cloud.timescale.com,
# paste its connection string, then run `python scripts/tiger_setup.py`.
TIGER_DATABASE_URL=

# Solana chain of custody. `python scripts/solana_setup.py` creates the sealing key at this path (devnet by default);
# fund its address with test SOL at https://faucet.solana.com.
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_CLUSTER=devnet
# SOLANA_KEYPAIR_FILE=var/solana-devnet.json
